# Comments are on their own lines on purpose: some env-file loaders keep an
# inline "# comment" as part of the value. Don't quote values unless needed.

# ---------------------------------------------------------------------------
# Upstream: your real mail server and the ONE credential the gateway uses.
# ---------------------------------------------------------------------------
UPSTREAM_HOST=mail.example.com
UPSTREAM_PORT=587
# starttls | tls (implicit TLS, usually port 465) | none
UPSTREAM_TLS=starttls
UPSTREAM_USERNAME=relay@example.com
# Or UPSTREAM_PASSWORD_FILE=/run/secrets/upstream
UPSTREAM_PASSWORD=change-me
# UPSTREAM_TLS_SKIP_VERIFY=false
# Force one MAIL FROM upstream (bounces go here; the From: header is untouched).
# Useful when the upstream only lets relay@... send as itself on the envelope.
# UPSTREAM_ENVELOPE_FROM=relay@example.com
# UPSTREAM_HELO=smtp-gateway.example.com
# UPSTREAM_TIMEOUT=1m

# ---------------------------------------------------------------------------
# Client-facing SMTP
# ---------------------------------------------------------------------------
# Greeting name, and the default certificate name.
SMTP_HOSTNAME=smtp-gateway.example.com
# Allow AUTH without TLS (only for trusted internal networks / legacy devices).
# SMTP_ALLOW_INSECURE_AUTH=false
# SMTP_MAX_MESSAGE_MB=25
# SMTP_MAX_RECIPIENTS=100
# Failed logins per IP before a lockout, and the lockout window.
# SMTP_AUTH_FAIL_LIMIT=10
# SMTP_AUTH_FAIL_WINDOW=15m
# Ports shown in the panel next to new credentials (host side of the mapping).
# SMTP_PUBLIC_SUBMISSION_PORT=587
# SMTP_PUBLIC_SMTPS_PORT=465

# ---------------------------------------------------------------------------
# TLS certificate for clients: self-signed (default) | file | acme
# ---------------------------------------------------------------------------
# TLS_SOURCE=acme
#
# file: your own certificate, re-read automatically when renewed.
# TLS_CERT_FILE=/certs/fullchain.pem
# TLS_KEY_FILE=/certs/privkey.pem
#
# acme: automatic certificates via lego, DNS-01 challenge (no inbound port 80).
# Setting this to true accepts the CA's subscriber agreement.
# ACME_ACCEPT_TOS=true
# ACME_EMAIL=you@example.com
# Comma separated; defaults to SMTP_HOSTNAME.
# ACME_DOMAINS=smtp-gateway.example.com
# letsencrypt | letsencrypt-staging | zerossl | googletrust | <directory URL>
# ACME_CA=letsencrypt
# ec256 | ec384 | rsa2048 | rsa3072 | rsa4096
# ACME_KEY_TYPE=ec256
# External account binding (ZeroSSL, Google Trust Services).
# ACME_EAB_KID=
# ACME_EAB_HMAC=
# ACME_DNS_RESOLVERS=1.1.1.1:53,8.8.8.8:53
# Set to true if outbound DNS to the zone's own nameservers is blocked.
# ACME_DNS_SKIP_AUTHORITATIVE=false
#
# Cloudflare: an API token with Zone:Read and DNS:Edit on the zone.
# ACME_DNS_PROVIDER=cloudflare
# CLOUDFLARE_DNS_API_TOKEN=
#
# AWS Route 53 (or use an IAM role / shared config). The zone ID is optional.
# ACME_DNS_PROVIDER=route53
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_HOSTED_ZONE_ID=

# ---------------------------------------------------------------------------
# Control panel (SSO via OpenID Connect). Set WEB_ADDR= (empty) to disable.
# ---------------------------------------------------------------------------
PUBLIC_URL=https://smtp-panel.example.com
# Register this redirect URI in your IdP, exactly: ${PUBLIC_URL}/auth/callback
#
# Authentik: create an "OAuth2/OpenID Provider" (client type: Confidential) and
# an Application that uses it. Then copy from the PROVIDER's page:
#   OIDC_ISSUER        = "OpenID Configuration Issuer"
#                        (https://<authentik>/application/o/<application-slug>/)
#   OIDC_CLIENT_ID     = "Client ID"     (a random string, NOT the slug)
#   OIDC_CLIENT_SECRET = "Client Secret"
OIDC_ISSUER=https://auth.example.com/application/o/smtp-gateway/
OIDC_CLIENT_ID=paste-the-client-id-from-your-provider
OIDC_CLIENT_SECRET=paste-the-client-secret-from-your-provider
# Who may sign in. Matching either list is enough. Leave both empty to accept
# anyone your IdP lets through (then restrict access in the IdP itself).
# Comma separated; @domain entries allowed.
OIDC_ALLOWED_EMAILS=you@example.com
# OIDC_ALLOWED_GROUPS=smtp-admins
# OIDC_GROUPS_CLAIM=groups
# Add "groups" if your IdP needs it for the groups claim.
# OIDC_SCOPES=openid,email,profile
# SESSION_TTL=8h
# Generated and stored in the database if unset.
# SESSION_SECRET=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
# LOG_RETENTION_DAYS=30
# debug | info | warn | error
# LOG_LEVEL=info
